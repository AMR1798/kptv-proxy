{
  "openapi": "3.1.0",
  "info": {
    "title": "KPTV Proxy API",
    "version": "1.1.111",
    "description": "REST API for KPTV Proxy. Admin endpoints require a session cookie or Bearer token with appropriate permissions; public Xtream Codes endpoints authenticate XC output account credentials per request."
  },
  "servers": [
    {
      "url": "",
      "description": "This server"
    }
  ],
  "security": [
    { "bearerAuth": [] },
    { "cookieAuth": [] }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "API token generated in the Accounts tab. Include as `Authorization: Bearer <token>`."
      },
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "kptv_session",
        "description": "Session cookie set on login."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": { "type": "string" }
        }
      },
      "Success": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "example": "success" }
        }
      },
      "Config": {
        "type": "object",
        "properties": {
          "baseURL":               { "type": "string",  "example": "http://localhost:8080" },
          "bufferSizePerStream":   { "type": "integer", "example": 8 },
          "cacheEnabled":          { "type": "boolean" },
          "cacheDuration":         { "type": "string",  "example": "30m" },
          "importRefreshInterval": { "type": "string",  "example": "12h" },
          "workerThreads":         { "type": "integer", "example": 8 },
          "logLevel":              { "type": "string",  "enum": ["DEBUG","INFO","WARN","ERROR","NONE"] },
          "obfuscateUrls":         { "type": "boolean" },
          "sortField":             { "type": "string",  "example": "tvg-name" },
          "sortDirection":         { "type": "string",  "enum": ["asc","desc"] },
          "streamTimeout":         { "type": "string",  "example": "30s" },
          "maxConnectionsToApp":   { "type": "integer", "example": 100 },
          "watcherEnabled":        { "type": "boolean" },
          "ffmpegMode":            { "type": "boolean" },
          "ffmpegPreInput":        { "type": "array",   "items": { "type": "string" } },
          "ffmpegPreOutput":       { "type": "array",   "items": { "type": "string" } },
          "responseHeaderTimeout": { "type": "string",  "example": "10s" },
          "slowClientBufferChunks": { "type": "integer", "example": 16 },
          "sources": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Source" }
          }
        }
      },
      "Source": {
        "type": "object",
        "required": ["name","url"],
        "properties": {
          "name":                   { "type": "string" },
          "url":                    { "type": "string" },
          "username":               { "type": "string" },
          "password":               { "type": "string" },
          "order":                  { "type": "integer", "example": 1 },
          "maxConnections":         { "type": "integer", "example": 5 },
          "maxStreamTimeout":       { "type": "string",  "example": "30s" },
          "retryDelay":             { "type": "string",  "example": "5s" },
          "maxRetries":             { "type": "integer", "example": 3 },
          "maxFailuresBeforeBlock": { "type": "integer", "example": 5 },
          "minDataSize":            { "type": "integer", "example": 2 },
          "userAgent":              { "type": "string" },
          "reqOrigin":              { "type": "string" },
          "reqReferrer":            { "type": "string" },
          "liveIncludeRegex":       { "type": "string" },
          "liveExcludeRegex":       { "type": "string" },
          "seriesIncludeRegex":     { "type": "string" },
          "seriesExcludeRegex":     { "type": "string" },
          "vodIncludeRegex":        { "type": "string" },
          "vodExcludeRegex":        { "type": "string" }
        }
      },
      "EPG": {
        "type": "object",
        "required": ["name","url"],
        "properties": {
          "id":    { "type": "integer" },
          "name":  { "type": "string" },
          "url":   { "type": "string" },
          "order": { "type": "integer", "example": 1 }
        }
      },
      "XCAccount": {
        "type": "object",
        "required": ["name","username","password"],
        "properties": {
          "id":             { "type": "integer" },
          "name":           { "type": "string" },
          "username":       { "type": "string" },
          "password":       { "type": "string" },
          "maxConnections": { "type": "integer", "example": 10 },
          "enableLive":     { "type": "boolean" },
          "enableSeries":   { "type": "boolean" },
          "enableVOD":      { "type": "boolean" }
        }
      },
      "SDAccount": {
        "type": "object",
        "required": ["name","username","password"],
        "properties": {
          "id":              { "type": "integer" },
          "name":            { "type": "string" },
          "username":        { "type": "string" },
          "password":        { "type": "string" },
          "enabled":         { "type": "boolean" },
          "daysToFetch":     { "type": "integer", "example": 7 },
          "selectedLineups": { "type": "array", "items": { "type": "string" } }
        }
      },
      "Channel": {
        "type": "object",
        "properties": {
          "name":    { "type": "string" },
          "active":  { "type": "boolean" },
          "clients": { "type": "integer" },
          "group":   { "type": "string" },
          "sources": { "type": "integer" },
          "logoURL": { "type": "string" }
        }
      },
      "ActiveChannel": {
        "allOf": [
          { "$ref": "#/components/schemas/Channel" },
          {
            "type": "object",
            "properties": {
              "bytesTransferred": { "type": "integer" },
              "currentSource":    { "type": "string" }
            }
          }
        ]
      },
      "StreamInfo": {
        "type": "object",
        "properties": {
          "index":       { "type": "integer" },
          "url":         { "type": "string" },
          "sourceName":  { "type": "string" },
          "sourceOrder": { "type": "integer" },
          "attributes":  { "type": "object", "additionalProperties": { "type": "string" } }
        }
      },
      "ChannelStreams": {
        "type": "object",
        "properties": {
          "channelName":          { "type": "string" },
          "currentStreamIndex":   { "type": "integer" },
          "preferredStreamIndex": { "type": "integer" },
          "obfuscated":           { "type": "boolean" },
          "streams": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/StreamInfo" }
          }
        }
      },
      "StreamStats": {
        "type": "object",
        "properties": {
          "streaming":       { "type": "boolean" },
          "container":       { "type": "string" },
          "videoCodec":      { "type": "string" },
          "audioCodec":      { "type": "string" },
          "videoResolution": { "type": "string" },
          "fps":             { "type": "number" },
          "audioChannels":   { "type": "string" },
          "bitrate":         { "type": "integer" },
          "streamType":      { "type": "string" },
          "valid":           { "type": "boolean" },
          "lastUpdated":     { "type": "integer" }
        }
      },
      "Stats": {
        "type": "object",
        "properties": {
          "totalChannels":       { "type": "integer" },
          "activeStreams":       { "type": "integer" },
          "totalSources":        { "type": "integer" },
          "totalEpgs":           { "type": "integer" },
          "connectedClients":    { "type": "integer" },
          "uptime":              { "type": "string" },
          "memoryUsage":         { "type": "string" },
          "cacheStatus":         { "type": "string" },
          "workerThreads":       { "type": "integer" },
          "totalConnections":    { "type": "integer" },
          "bytesTransferred":    { "type": "string" },
          "activeRestreamers":   { "type": "integer" },
          "streamErrors":        { "type": "integer" },
          "responseTime":        { "type": "string" },
          "watcherEnabled":      { "type": "boolean" },
          "upstreamConnections": { "type": "integer" },
          "activeChannels":      { "type": "integer" },
          "avgClientsPerStream": { "type": "number" }
        }
      },
      "LogEntry": {
        "type": "object",
        "properties": {
          "timestamp": { "type": "string" },
          "level":     { "type": "string", "enum": ["debug","info","warn","error"] },
          "message":   { "type": "string" }
        }
      },
      "Token": {
        "type": "object",
        "properties": {
          "id":          { "type": "integer" },
          "name":        { "type": "string" },
          "permissions": { "type": "integer" }
        }
      },
      "Permissions": {
        "type": "object",
        "properties": {
          "read":        { "type": "integer", "example": 1 },
          "configWrite": { "type": "integer", "example": 2 },
          "restart":     { "type": "integer", "example": 4 },
          "streams":     { "type": "integer", "example": 8 },
          "logs":        { "type": "integer", "example": 16 },
          "xcAccounts":  { "type": "integer", "example": 32 },
          "epgs":        { "type": "integer", "example": 64 },
          "sd":          { "type": "integer", "example": 128 },
          "all":         { "type": "integer", "example": 255 }
        }
      },
      "XCUserInfo": {
        "type": "object",
        "required": ["username","password","auth","status","active_cons","max_connections","allowed_output_formats"],
        "properties": {
          "username":               { "type": "string" },
          "password":               { "type": "string" },
          "message":                { "type": "string" },
          "auth":                   { "type": "integer", "enum": [0,1] },
          "status":                 { "type": "string" },
          "exp_date":               { "type": ["string","null"] },
          "is_trial":               { "type": "string" },
          "active_cons":            { "type": "string", "description": "Active playback sessions; metadata requests do not increment this value." },
          "created_at":             { "type": "string" },
          "max_connections":        { "type": "string" },
          "allowed_output_formats": { "type": "array", "items": { "type": "string", "enum": ["ts","m3u8"] } }
        }
      },
      "XCServerInfo": {
        "type": "object",
        "required": ["url","port","https_port","server_protocol","timezone","timestamp_now","time_now"],
        "properties": {
          "url":             { "type": "string" },
          "port":            { "type": "string" },
          "https_port":      { "type": "string" },
          "server_protocol": { "type": "string", "enum": ["http","https"] },
          "rtmp_port":       { "type": "string" },
          "timezone":        { "type": "string" },
          "timestamp_now":   { "type": "integer" },
          "time_now":        { "type": "string" }
        }
      },
      "XCAuthResponse": {
        "type": "object",
        "required": ["user_info"],
        "properties": {
          "user_info":   { "$ref": "#/components/schemas/XCUserInfo" },
          "server_info": { "$ref": "#/components/schemas/XCServerInfo" }
        }
      },
      "XCCategory": {
        "type": "object",
        "required": ["category_id","category_name","parent_id"],
        "properties": {
          "category_id":   { "type": "string" },
          "category_name": { "type": "string" },
          "parent_id":     { "type": "integer" }
        }
      },
      "XCStream": {
        "type": "object",
        "required": ["num","name","stream_type","stream_id","category_id","direct_source"],
        "properties": {
          "num":                 { "type": "integer" },
          "name":                { "type": "string" },
          "stream_type":         { "type": "string", "enum": ["live","vod","series"] },
          "stream_id":           { "type": "integer" },
          "stream_icon":         { "type": "string" },
          "epg_channel_id":      { "type": "string" },
          "category_id":         { "type": "string" },
          "direct_source":       { "type": "string", "format": "uri" },
          "container_extension": { "type": "string" }
        }
      },
      "XCVODDetail": {
        "type": "object",
        "required": ["info","movie_data"],
        "properties": {
          "info": { "type": "object", "additionalProperties": true },
          "movie_data": {
            "type": "object",
            "required": ["stream_id","name","container_extension"],
            "properties": {
              "stream_id":           { "type": "string" },
              "name":                { "type": "string" },
              "container_extension": { "type": "string" }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      },
      "XCSeriesEpisode": {
        "type": "object",
        "required": ["id","container_extension"],
        "properties": {
          "id":                  { "type": "string", "description": "Proxy episode ID accepted by the series playback route." },
          "episode_num":         { "type": "string" },
          "title":               { "type": "string" },
          "container_extension": { "type": "string" }
        },
        "additionalProperties": true
      },
      "XCSeriesDetail": {
        "type": "object",
        "required": ["info","seasons","episodes"],
        "properties": {
          "info":    { "type": "object", "additionalProperties": true },
          "seasons": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
          "episodes": {
            "type": "object",
            "description": "Episode arrays keyed by season number.",
            "additionalProperties": { "type": "array", "items": { "$ref": "#/components/schemas/XCSeriesEpisode" } }
          }
        },
        "additionalProperties": true
      },
      "XCEPGResponse": {
        "type": "object",
        "required": ["epg_listings"],
        "properties": {
          "epg_listings": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id","epg_id","title","start","end","channel_id","start_timestamp","stop_timestamp","has_archive"],
              "properties": {
                "id":              { "type": "string" },
                "epg_id":          { "type": "string" },
                "title":           { "type": "string", "description": "Base64-encoded title." },
                "description":     { "type": "string", "description": "Base64-encoded description." },
                "start":           { "type": "string" },
                "end":             { "type": "string" },
                "channel_id":      { "type": "string" },
                "start_timestamp": { "type": "string" },
                "stop_timestamp":  { "type": "string" },
                "now_playing":     { "type": "integer" },
                "has_archive":     { "type": "integer", "enum": [0] }
              }
            }
          }
        }
      }
    }
  },
  "paths": {
    "/player_api.php": {
      "get": {
        "summary": "Query the Xtream-compatible player API",
        "description": "Authenticates an XC output account. Supported actions are get_live_categories, get_live_streams, get_vod_categories, get_vod_streams, get_vod_info, get_series_categories, get_series, get_series_info, get_short_epg, and get_simple_data_table. An omitted or unknown action returns account and server information. Catalog actions accept an optional generated category_id; detail and EPG actions use typed catalog IDs.",
        "operationId": "getXCPlayerAPI",
        "tags": ["Xtream Codes"],
        "security": [],
        "parameters": [
          { "name": "username", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "password", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "action", "in": "query", "schema": { "type": "string" } },
          { "name": "category_id", "in": "query", "schema": { "type": "string" }, "description": "Category ID returned by the matching category action; omitted or 0 selects all." },
          { "name": "vod_id", "in": "query", "schema": { "type": "string" } },
          { "name": "series_id", "in": "query", "schema": { "type": "string" } },
          { "name": "stream_id", "in": "query", "schema": { "type": "string" }, "description": "Live stream ID for EPG actions." },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 1000 } }
        ],
        "responses": {
          "200": {
            "description": "Action-dependent XC response. Disabled catalog content and unknown category or EPG IDs return typed empty collections.",
            "content": { "application/json": { "schema": { "oneOf": [
              { "$ref": "#/components/schemas/XCAuthResponse" },
              { "type": "array", "items": { "$ref": "#/components/schemas/XCCategory" } },
              { "type": "array", "items": { "$ref": "#/components/schemas/XCStream" } },
              { "$ref": "#/components/schemas/XCVODDetail" },
              { "$ref": "#/components/schemas/XCSeriesDetail" },
              { "$ref": "#/components/schemas/XCEPGResponse" }
            ] } } }
          },
          "400": { "description": "Ambiguous or malformed request parameters" },
          "401": { "description": "Invalid XC credentials", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/XCAuthResponse" } } } },
          "404": { "description": "Detail ID not found or content type disabled" },
          "502": { "description": "Provider detail response unavailable" },
          "503": { "description": "Catalog or account changed during detail resolution" }
        }
      },
      "post": {
        "summary": "Query the Xtream-compatible player API with form parameters",
        "description": "Equivalent to GET. Parameters may be supplied in the query, an application/x-www-form-urlencoded body, or both. Form values override query values; duplicate supported fields within either source are rejected.",
        "operationId": "postXCPlayerAPI",
        "tags": ["Xtream Codes"],
        "security": [],
        "parameters": [
          { "name": "username", "in": "query", "schema": { "type": "string" } },
          { "name": "password", "in": "query", "schema": { "type": "string" } },
          { "name": "action", "in": "query", "schema": { "type": "string" } },
          { "name": "category_id", "in": "query", "schema": { "type": "string" } },
          { "name": "vod_id", "in": "query", "schema": { "type": "string" } },
          { "name": "series_id", "in": "query", "schema": { "type": "string" } },
          { "name": "stream_id", "in": "query", "schema": { "type": "string" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 1000 } }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "username":    { "type": "string" },
                  "password":    { "type": "string" },
                  "action":      { "type": "string" },
                  "category_id": { "type": "string" },
                  "vod_id":      { "type": "string" },
                  "series_id":   { "type": "string" },
                  "stream_id":   { "type": "string" },
                  "limit":       { "type": "integer", "minimum": 1, "maximum": 1000 }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Same action-dependent response shapes as GET" },
          "400": { "description": "Ambiguous or malformed request parameters" },
          "401": { "description": "Invalid XC credentials" },
          "404": { "description": "Detail ID not found or content type disabled" },
          "502": { "description": "Provider detail response unavailable" },
          "503": { "description": "Catalog or account changed during detail resolution" }
        }
      }
    },
    "/get.php": {
      "get": {
        "summary": "Download an XC account M3U playlist",
        "description": "Returns enabled live, VOD, and series catalog entries. Generated live and VOD URLs resolve through the corresponding typed playback routes.",
        "operationId": "getXCM3UPlaylist",
        "tags": ["Xtream Codes"],
        "security": [],
        "parameters": [
          { "name": "username", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "password", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "type", "in": "query", "required": true, "schema": { "type": "string", "enum": ["m3u","m3u_plus"] } }
        ],
        "responses": {
          "200": { "description": "M3U playlist", "content": { "application/x-mpegURL": { "schema": { "type": "string" } } } },
          "400": { "description": "Unsupported output type or ambiguous parameters" },
          "401": { "description": "Invalid XC credentials" }
        }
      }
    },
    "/xmltv.php": {
      "get": {
        "summary": "Download XMLTV data for an XC account",
        "description": "Requires Live content to be enabled for the account.",
        "operationId": "getXCXMLTV",
        "tags": ["Xtream Codes"],
        "security": [],
        "parameters": [
          { "name": "username", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "password", "in": "query", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "XMLTV document", "content": { "application/xml": { "schema": { "type": "string" } } } },
          "401": { "description": "Invalid XC credentials" },
          "404": { "description": "Live content disabled" },
          "503": { "description": "No EPG data available" }
        }
      }
    },
    "/live/{username}/{password}/{id}": {
      "get": {
        "summary": "Play a live XC stream",
        "description": "Uses a live stream_id returned by get_live_streams. Enable Live and the account's active playback limit are enforced. Credentials containing a slash cannot be represented reliably by this path route.",
        "operationId": "playXCLive",
        "tags": ["Xtream Codes"],
        "security": [],
        "parameters": [
          { "name": "username", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "password", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" }, "description": "Live stream ID, optionally followed by .ts." }
        ],
        "responses": {
          "200": { "description": "Streaming response" },
          "400": { "description": "Malformed stream ID" },
          "401": { "description": "Invalid XC credentials" },
          "404": { "description": "Live stream not found or disabled" },
          "429": { "description": "Per-account playback limit reached" },
          "503": { "description": "Global server capacity reached" }
        }
      }
    },
    "/movie/{username}/{password}/{id}": {
      "get": {
        "summary": "Play an XC VOD item",
        "description": "Uses a VOD stream_id returned by get_vod_streams. Enable VOD and the account's active playback limit are enforced. Credentials containing a slash cannot be represented reliably by this path route.",
        "operationId": "playXCVOD",
        "tags": ["Xtream Codes"],
        "security": [],
        "parameters": [
          { "name": "username", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "password", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" }, "description": "VOD stream ID followed optionally by its container extension." }
        ],
        "responses": {
          "200": { "description": "Streaming response" },
          "400": { "description": "Malformed stream ID" },
          "401": { "description": "Invalid XC credentials" },
          "404": { "description": "VOD item not found, cross-content ID, or disabled" },
          "429": { "description": "Per-account playback limit reached" },
          "503": { "description": "Global server capacity reached" }
        }
      }
    },
    "/series/{username}/{password}/{id}": {
      "get": {
        "summary": "Play an XC series episode",
        "description": "Uses an episode ID returned by get_series_info, not the parent series_id. Enable Series and the account's active playback limit are enforced. Catch-up and timeshift are not supported. Credentials containing a slash cannot be represented reliably by this path route.",
        "operationId": "playXCSeriesEpisode",
        "tags": ["Xtream Codes"],
        "security": [],
        "parameters": [
          { "name": "username", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "password", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" }, "description": "Episode ID followed optionally by its container extension." }
        ],
        "responses": {
          "200": { "description": "Streaming response" },
          "400": { "description": "Malformed episode ID" },
          "401": { "description": "Invalid XC credentials" },
          "404": { "description": "Episode not found, cross-content ID, or disabled" },
